{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal surface — no arbitrary shell, no filesystem write, no HTTP plugin. Backend lifecycle only: start/stop/restart/health with a fixed sidecar argv.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "allow-backend-start",
    "allow-backend-stop",
    "allow-backend-info",
    "allow-backend-restart",
    "allow-backend-health",
    "allow-api-token",
    "allow-default-home"
  ]
}
